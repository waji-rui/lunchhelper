<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <RootNamespace>LunchHelper</RootNamespace>
    <AssemblyName>LunchHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyInformationalVersion>1.0.0</AssemblyInformationalVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <!-- 强制 x64：与 WebView2Loader.dll（包内 x64 原生）架构一致，避免 AnyCPU 32-bit-preferred 下加载器不匹配 -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- 经典 csproj + PackageReference 还原模式：msbuild -restore 原生支持，
         自动下载 Microsoft.Web.WebView2 并注入程序集引用与 WebView2Loader.dll 拷贝 -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- WebView2：配置界面改用内嵌 Chromium 渲染（Evergreen，依赖系统已装的 WebView2 Runtime）。
       MIT 许可，GPL-3.0 兼容；对外发布前请补 THIRD-PARTY-NOTICES 署名。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\Program.cs" />
    <Compile Include="src\NativeMethods.cs" />
    <Compile Include="src\LockSignal.cs" />
    <Compile Include="src\ConsoleHelper.cs" />
    <Compile Include="src\ConfigManager.cs" />
    <Compile Include="src\Logger.cs" />
    <Compile Include="src\AntiTamper.cs" />
    <Compile Include="src\Guardian.cs" />
    <Compile Include="src\NumericPad.cs" />
    <Compile Include="src\ConfigForm.cs" />
    <Compile Include="src\LockForm.cs" />
    <Compile Include="src\PluginHost.cs" />
  </ItemGroup>

  <!-- 配置界面与可复用 UI 的离线资源（均为内嵌资源，运行时由 ConfigForm.LoadHtml 组合注入，
       WebView2.NavigateToString 加载，无需联网）：
       - ConfigPage.html           标记骨架，<head> 内含 /*CSS_TOKENS*/ /*CSS_COMPONENTS*/ /*CSS_DIALOG*/ 占位符，
                                     <script> 内含 /*JS_DIALOG*/ 占位符
       - ui/tokens.css             设计令牌层（颜色/形状/字体/动效/尺寸令牌）——主题/插件系统的主要覆盖面
       - ui/components.css         通用组件与布局样式（按钮/卡片/输入/开关/导航/页），消费上述令牌
       - ui/dialog.css             MD3 对话框专属样式（弹窗可复用，插件/配置页共用）
       - ui/dialog.js              MD3Dialog.show(opts) 弹窗组件（返回 Promise<buttonId>，跟随 no-anim 动画）
       - ui/host-bridge.js         宿主桥接层：window.LunchHelper.host.*（getConfig/setConfig/showDialog 等），
                                    前端↔C# 经消息 id 配对回执；插件只用此 API，不碰 postMessage -->
  <ItemGroup>
    <EmbeddedResource Include="src\ConfigPage.html" />
    <EmbeddedResource Include="src\ui\tokens.css" />
    <EmbeddedResource Include="src\ui\components.css" />
    <EmbeddedResource Include="src\ui\dialog.css" />
    <EmbeddedResource Include="src\ui\dialog.js" />
    <EmbeddedResource Include="src\ui\host-bridge.js" />
    <EmbeddedResource Include="src\ui\animations.js" />
    <EmbeddedResource Include="src\ui\markdown.js" />
  </ItemGroup>

  <!-- 示例插件（plugins/）：拷贝到输出目录，便于本地验证插件加载机制。
       第三方真插件运行时同样放在 exe 同目录的 plugins/ 下，由 PluginHost 扫描加载。 -->
  <ItemGroup>
    <Content Include="plugins\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- NuGet 还原生成的 props（定义 PackageReference 相关属性）；经典工程需手动导入。
       .targets 由 Microsoft.Common.targets 自动导入（重复导入会触发 MSB4011 警告），故此处不再导入。 -->
  <Import Project="$(MSBuildProjectExtensionsPath)$(MSBuildProjectFile).nuget.g.props"
          Condition="Exists('$(MSBuildProjectExtensionsPath)$(MSBuildProjectFile).nuget.g.props')" />

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
